[Unit]
Description=ClipForge Bot YouTube discovery (run by clipforge-discovery.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=clipforge
Group=clipforge
WorkingDirectory=/opt/clipforge-bot/backend
EnvironmentFile=/etc/clipforge-bot/backend.env
ExecStart=/opt/clipforge-bot/backend/.venv/bin/python -m clipforge.discovery_cli --scheduled
TimeoutStartSec=15min
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
