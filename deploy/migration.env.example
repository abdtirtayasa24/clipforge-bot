# Schema-owner credentials, used only by deploy/install.sh to run Alembic (ADR-003).
# Install as /etc/clipforge-bot/migration.env, owner root:root, mode 0600. Services never read it.
# Placeholders only: never commit real values.
CLIPFORGE_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/clipforge-bot/supabase-ca.crt
