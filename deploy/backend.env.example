# Runtime settings for clipforge-api (and later clipforge-worker / clipforge-discovery).
# Install as /etc/clipforge-bot/backend.env, owner root:clipforge, mode 0640.
# Placeholders only: never commit real values.
#
# CLIPFORGE_DATABASE_URL uses a login user that is a member of the clipforge_app role, created
# once in Supabase SQL editor:
#   CREATE ROLE clipforge_app_prod LOGIN PASSWORD '<generated>' IN ROLE clipforge_app;
# Connect through the Supabase session pooler with TLS verification; download the Supabase CA
# certificate to /etc/clipforge-bot/supabase-ca.crt.
CLIPFORGE_LOG_LEVEL=INFO
CLIPFORGE_DATABASE_URL=postgresql://clipforge_app_prod.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/clipforge-bot/supabase-ca.crt
CLIPFORGE_DB_POOL_SIZE=5
CLIPFORGE_WORKSPACE_DIR=/var/lib/clipforge-bot/workspace
CLIPFORGE_TELEGRAM_BOT_TOKEN=CHANGE_ME
# Generate with: openssl rand -hex 32
CLIPFORGE_SESSION_SECRET=CHANGE_ME
CLIPFORGE_INIT_DATA_MAX_AGE_SECONDS=3600
# YouTube Data API v3 key (Google Cloud console; restrict it to the YouTube Data API).
YOUTUBE_API_KEY=CHANGE_ME
# AI provider keys, referenced by name from ai_provider_configs.secret_ref (ADR-009, ADR-027).
# Gemini: Google AI Studio API key. OpenRouter: only needed while its fallback model is selected.
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
# Google Drive OAuth (ADR-015): a "Web application" OAuth client in Google Cloud console with
# the Drive API enabled; the redirect URI must be registered on the client exactly as below.
CLIPFORGE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
CLIPFORGE_GOOGLE_CLIENT_SECRET=CHANGE_ME
CLIPFORGE_DRIVE_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/integrations/drive/callback
# Encrypts the stored Drive refresh token. Back it up: losing it means reconnecting Drive.
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CLIPFORGE_TOKEN_ENCRYPTION_KEY=CHANGE_ME
